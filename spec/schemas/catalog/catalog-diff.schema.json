{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:catalog-diff:0.1",
  "title": "Baga Catalog Diff",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "repository_id", "from_sequence", "to_sequence", "created_at", "added", "updated", "removed"],
  "properties": {
    "type": {"const": "baga.catalog-diff"},
    "format": {"const": "0.1"},
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "from_sequence": {"type": "integer", "minimum": 0},
    "to_sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "added": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/appRef"}},
    "updated": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/appRef"}},
    "removed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160}}
  },
  "$defs": {
    "appRef": {
      "type": "object", "additionalProperties": false,
      "required": ["app_id", "path", "length", "sha256"],
      "properties": {
        "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
