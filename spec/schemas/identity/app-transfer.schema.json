{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:app-transfer:0.1",
  "title": "Baga App Transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "direction", "app_id", "old_publisher_id", "new_publisher_id", "transfer_sequence", "last_release_sequence", "transfer_nonce", "created_at"],
  "properties": {
    "type": {"const": "baga.app-transfer"},
    "format": {"const": "0.1"},
    "direction": {"enum": ["out", "in"]},
    "app_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 160},
    "old_publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "new_publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "transfer_sequence": {"type": "integer", "minimum": 1},
    "last_release_sequence": {"type": "integer", "minimum": 0},
    "transfer_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
