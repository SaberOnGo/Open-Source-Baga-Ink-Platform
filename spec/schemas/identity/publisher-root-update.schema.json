{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:publisher-root-update:0.1",
  "title": "Baga Publisher Root Update",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "publisher_id", "root_sequence", "previous_root_sha256", "root_threshold", "root_keys", "recovery_threshold", "recovery_keys", "effective_at"],
  "properties": {
    "type": {"const": "baga.publisher-root-update"},
    "format": {"const": "0.1"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "root_sequence": {"type": "integer", "minimum": 2},
    "previous_root_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "root_threshold": {"type": "integer", "minimum": 1},
    "root_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "recovery_threshold": {"type": "integer", "minimum": 1},
    "recovery_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "effective_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key"],
      "properties": {
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
        "algorithm": {"const": "ed25519"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    }
  }
}
