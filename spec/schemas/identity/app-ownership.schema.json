{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:app-ownership:0.1",
  "title": "Baga App Ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "publisher_id", "app_id", "ownership_sequence", "created_at"],
  "properties": {
    "type": {"const": "baga.app-ownership"},
    "format": {"const": "0.1"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "ownership_sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
