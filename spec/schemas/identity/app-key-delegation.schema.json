{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:app-key-delegation:0.1",
  "title": "Baga App Key Delegation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "publisher_id", "app_id", "delegation_sequence", "key_id", "public_key", "signature_threshold", "allowed_channels", "min_release_sequence", "max_release_sequence", "valid_from", "valid_until", "status"],
  "properties": {
    "type": {"const": "baga.app-key-delegation"},
    "format": {"const": "0.1"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 160},
    "delegation_sequence": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"},
    "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "signature_threshold": {"type": "integer", "minimum": 1},
    "allowed_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stable", "beta", "nightly"]}},
    "min_release_sequence": {"type": "integer", "minimum": 1},
    "max_release_sequence": {"type": "integer", "minimum": 1},
    "valid_from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "valid_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "status": {"enum": ["active", "retired", "revoked"]}
  }
}
