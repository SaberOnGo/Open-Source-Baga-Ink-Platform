{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:app-key-delegation:0.1",
  "title": "Baga App Key Delegation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "publisher_id", "app_id", "delegation_sequence", "key_id", "public_key", "channels", "release_sequence_min", "release_sequence_max", "valid_from", "expires"],
  "properties": {
    "type": {"const": "baga.app-key-delegation"},
    "format": {"const": "0.1"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "delegation_sequence": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stable", "beta", "nightly"]}},
    "release_sequence_min": {"type": "integer", "minimum": 1},
    "release_sequence_max": {"type": "integer", "minimum": 1},
    "valid_from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
