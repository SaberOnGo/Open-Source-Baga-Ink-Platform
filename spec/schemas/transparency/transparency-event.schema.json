{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:transparency-event:0.1",
  "title": "Baga Transparency Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "event_type", "event_id", "subject", "statement", "repository_id", "observed_at", "critical"],
  "properties": {
    "type": {"const": "baga.transparency-event"},
    "format": {"const": "0.1"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9_]{3,64}$"},
    "event_id": {"type": "string", "pattern": "^evt1_[a-z2-7]{52}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
        "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
        "release_sequence": {"type": "integer", "minimum": 1},
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"}
      }
    },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "critical": {"type": "boolean"}
  }
}
