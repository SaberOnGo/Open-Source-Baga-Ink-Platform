{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:offline-snapshot-manifest:0.1",
  "title": "Baga Offline Repository Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "repository_id", "root_version", "snapshot_version", "timestamp_version", "created_at", "expires", "targets"],
  "properties": {
    "type": {"const": "baga.offline-snapshot-manifest"},
    "format": {"const": "0.1"},
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "root_version": {"type": "integer", "minimum": 1},
    "snapshot_version": {"type": "integer", "minimum": 1},
    "timestamp_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "length", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "length": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
