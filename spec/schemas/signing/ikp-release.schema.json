{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:ikp-release:0.1",
  "title": "Baga IKP Release Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "app_id", "publisher_id", "version_name", "release_sequence", "channel", "ikp_format", "baga_api", "manifest", "files_manifest", "publisher_identity_digest", "app_ownership_digest", "app_key_delegation_digest", "app_signing_key_id", "created_at"],
  "properties": {
    "type": {"const": "baga.ikp-release"},
    "format": {"const": "0.1"},
    "app_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 160},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "version_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "release_sequence": {"type": "integer", "minimum": 1},
    "channel": {"enum": ["stable", "beta", "nightly"]},
    "ikp_format": {"type": "string", "pattern": "^[0-9]+\.[0-9]+$"},
    "baga_api": {
      "type": "object", "additionalProperties": false,
      "required": ["min", "max_exclusive"],
      "properties": {
        "min": {"type": "string", "pattern": "^[0-9]+\.[0-9]+$"},
        "max_exclusive": {"type": "string", "pattern": "^[0-9]+\.[0-9]+$"}
      }
    },
    "manifest": {"$ref": "#/$defs/target"},
    "files_manifest": {"$ref": "#/$defs/target"},
    "publisher_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "app_ownership_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "app_key_delegation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "app_signing_key_id": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$)).+$"},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
