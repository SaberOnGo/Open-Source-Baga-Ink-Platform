{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:signature-set:0.1",
  "title": "Baga Signature Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "signed_object", "signed_object_sha256", "signatures"],
  "properties": {
    "type": {"const": "baga.signature-set"},
    "format": {"const": "0.1"},
    "signed_object": {"type": "string", "minLength": 1, "maxLength": 512},
    "signed_object_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signatures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "algorithm", "signature"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"},
          "algorithm": {"const": "ed25519"},
          "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
        }
      }
    }
  }
}
