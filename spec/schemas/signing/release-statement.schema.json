{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:release-statement:0.1",
  "title": "Baga Release Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "publisher_id", "app_id", "release_sequence", "version_name", "channel", "package_sha256", "package_length", "manifest_sha256", "permissions", "capabilities", "data_schema_version", "created_at"],
  "properties": {
    "type": {"const": "baga.release-statement"},
    "format": {"const": "0.1"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "release_sequence": {"type": "integer", "minimum": 1},
    "version_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "channel": {"enum": ["stable", "beta", "nightly"]},
    "package_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "package_length": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
        "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}}
      }
    },
    "data_schema_version": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
