{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:revocation-statement:0.1",
  "title": "Baga Revocation Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "scope", "issuer_id", "severity", "reason_code", "issued_at"],
  "properties": {
    "type": {"const": "baga.revocation-statement"},
    "format": {"const": "0.1"},
    "scope": {"enum": ["release", "key", "publisher", "app"]},
    "issuer_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "release_sequence": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{3,64}$"},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "replacement_sequence": {"type": "integer", "minimum": 1}
  }
}
