{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:review-attestation:0.1",
  "title": "Baga Review Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "repository_id", "app_id", "release_sequence", "review_id", "result", "reviewer_kind", "checks", "issued_at"],
  "properties": {
    "type": {"const": "baga.review-attestation"},
    "format": {"const": "0.1"},
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "release_sequence": {"type": "integer", "minimum": 1},
    "review_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "result": {"enum": ["approved", "rejected", "conditional"]},
    "reviewer_kind": {"enum": ["automated", "human", "reproducible-build", "security"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "result": {"enum": ["pass", "fail", "warning", "not_applicable"]}
        }
      }
    },
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
