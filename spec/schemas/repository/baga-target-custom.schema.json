{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:baga-target-custom:0.1",
  "title": "Baga TUF Target Custom Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "kind"],
  "properties": {
    "type": {"const": "baga.target-custom"},
    "format": {"const": "0.1"},
    "kind": {"enum": ["ikp", "release", "publisher", "ownership", "delegation", "review", "revocation", "catalog", "asset", "transparency"]},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 160},
    "release_sequence": {"type": "integer", "minimum": 1},
    "channel": {"enum": ["stable", "beta", "nightly"]}
  }
}
