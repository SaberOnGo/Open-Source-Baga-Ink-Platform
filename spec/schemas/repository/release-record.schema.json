{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baga:schema:release-record:0.1",
  "title": "Baga Repository Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "format", "repository_id", "publisher_id", "app_id", "release_sequence", "version_name", "channel", "status", "package", "release_statement", "published_at"],
  "properties": {
    "type": {"const": "baga.release-record"},
    "format": {"const": "0.1"},
    "repository_id": {"type": "string", "pattern": "^repo1_[a-z2-7]{52}$"},
    "publisher_id": {"type": "string", "pattern": "^pub1_[a-z2-7]{52}$"},
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$", "maxLength": 160},
    "release_sequence": {"type": "integer", "minimum": 1},
    "version_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "channel": {"enum": ["stable", "beta", "nightly"]},
    "status": {"enum": ["published", "withdrawn", "unlisted", "security_revoked"]},
    "package": {"$ref": "#/$defs/target"},
    "release_statement": {"$ref": "#/$defs/target"},
    "published_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
